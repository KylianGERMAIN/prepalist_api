  "info": {
    "title": "PrepaList API",
    "description": "API meal-prep PrepaList v2",
    "version": "2",
    "contact": {}
  },
  "tags": [],
  "servers": [],
  "components": {
    "securitySchemes": {
      "bearer": {
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "type": "http"
      }
    },
    "schemas": {
      "MeDto": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string"
          },
          "email": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": [
              "USER",
              "ADMIN"
            ]
          },
          "shoppingDay": {
            "type": "number",
            "minimum": 0,
            "maximum": 6
          }
        },
        "required": [
          "id",
          "email",
          "role",
          "shoppingDay"
        ]
      },
      "UpdateMeDto": {
        "type": "object",
        "properties": {
          "shoppingDay": {
            "type": "number",
            "minimum": 0,
            "maximum": 6,
            "description": "Jour de courses (0 = dimanche … 6 = samedi)."
          }
        },
        "required": [
          "shoppingDay"
        ]
      },
      "RegisterDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
            "example": "user@example.com"
          },
          "password": {
            "type": "string",
            "minLength": 8
          }
        },
        "required": [
          "email",
          "password"
        ]
      },
      "TokenPairDto": {
        "type": "object",
        "properties": {
          "accessToken": {
            "type": "string"
          },
          "refreshToken": {
            "type": "string"
          }
        },
        "required": [
          "accessToken",
          "refreshToken"
        ]
      },
      "LoginDto": {
        "type": "object",
        "properties": {
          "email": {
            "type": "string",
